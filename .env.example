# Real key → OpenAI structured extraction. Placeholder/empty → mock extractor (still evidence-validated).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# EXTRACTION_MODE=openai   # force OpenAI
# EXTRACTION_MODE=mock     # force mock

# --- API / worker (Docker + Vercel) ---
# Local compose uses host-mapped ports; Vercel Neon integration sets DATABASE_URL.
DATABASE_URL=postgresql://lomi:lomi@localhost:5433/lomi?schema=public
# Local Redis or Upstash (Vercel Marketplace) for BullMQ.
REDIS_URL=redis://localhost:6380
UPLOAD_DIR=/app/storage/uploads
API_PORT=3001
# Include /api so CSV pdf_url links match the public rewrite / dual Express mount.
PUBLIC_API_URL=http://localhost:3001/api

# Vercel Blob (required on Vercel so API Functions + worker Daemon share PDFs).
# Add via Vercel Storage → Blob; sets BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=

# --- Web (local + Vercel) ---
# Browser-reachable API base. On Vercel leave unset to use same-origin `/api`
# (edge rewrite → api service). Service binding injects API_URL for SSR.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
