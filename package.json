{
  "name": "lomi-take-home",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lomi/db generate",
    "db:migrate": "pnpm --filter @lomi/db migrate:deploy",
    "db:migrate:vercel": "node packages/db/scripts/migrate-with-env.mjs",
    "db:seed": "pnpm --filter @lomi/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
